{
  "name": "vue-dependency-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./devtools/style.css": "./dist/devtools/style.css"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && vue-tsc -p tsconfig.build.json && vite build --config vite.lib.config.ts && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "22.13.10",
    "@vitejs/plugin-vue": "5.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/compiler-sfc": "3.5.13",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "26.0.0",
    "pinia": "3.0.4",
    "playwright": "1.62.1",
    "prettier": "^3.9.8",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue": "3.5.13",
    "vue-tsc": "2.2.8"
  },
  "files": [
    "dist/core",
    "dist/vue",
    "dist/devtools",
    "dist/chunks"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
